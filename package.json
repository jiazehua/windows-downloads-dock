{
  "name": "downloadsdock",
  "version": "2.1.4",
  "description": "Windows 下载浮窗 + 最近图片：Ctrl+Shift+V 在鼠标位置弹出双栏浮层，左栏管下载文件夹，右栏自动收集剪贴板图片并支持临时暂存架",
  "main": "main.js",
  "author": "穿山贾",
  "license": "MIT",
  "scripts": {
    "start": "node run.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "icon": "node gen-icon.js"
  },
  "build": {
    "appId": "com.chuanshanjia.downloadsdock",
    "productName": "DownloadsDock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "下载浮窗"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "clipshelf/**",
      "hook.ps1",
      "drag-helper.ps1",
      "copy-helper.ps1",
      "paste-helper.ps1",
      "cut-helper.ps1",
      "extract-helper.ps1",
      "assets/icon.png",
      "assets/folder.png"
    ],
    "asarUnpack": [
      "hook.ps1",
      "drag-helper.ps1",
      "copy-helper.ps1",
      "paste-helper.ps1",
      "cut-helper.ps1",
      "extract-helper.ps1"
    ]
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
